@startuml
!pragma layout smetana
hide circle
skinparam linetype ortho

entity "users" as users {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * phone : VARCHAR(20) <<UNIQUE>>
  * role : ENUM('RIDER','DRIVER')
  * rating_sum : INT
  * rating_count : INT
  * created_at : TIMESTAMP
}

entity "drivers" as drivers {
  * user_id : BIGINT <<PK, FK>>
  --
  * license_no : VARCHAR(30) <<UNIQUE>>
  * status : ENUM('OFFLINE','AVAILABLE','ON_TRIP')
  current_lat : DECIMAL(9,6)
  current_lng : DECIMAL(9,6)
  location_updated_at : TIMESTAMP
  ..
  INDEX(status, current_lat, current_lng)
}

entity "vehicles" as vehicles {
  * id : BIGINT <<PK>>
  --
  * driver_id : BIGINT <<FK>> <<UNIQUE>>
  * number : VARCHAR(15) <<UNIQUE>>
  * model : VARCHAR(50)
  * type : ENUM('BIKE','AUTO','MINI','SEDAN','SUV')
}

entity "fare_rates" as fare_rates {
  * vehicle_type : ENUM('BIKE','AUTO','MINI','SEDAN','SUV') <<PK>>
  --
  * base_fare : DECIMAL(8,2)
  * per_km : DECIMAL(8,2)
}

entity "rides" as rides {
  * id : BIGINT <<PK>>
  --
  * rider_id : BIGINT <<FK>>
  driver_id : BIGINT <<FK>>
  vehicle_id : BIGINT <<FK>>
  * vehicle_type : ENUM('BIKE','AUTO','MINI','SEDAN','SUV')
  * pickup_lat : DECIMAL(9,6)
  * pickup_lng : DECIMAL(9,6)
  * drop_lat : DECIMAL(9,6)
  * drop_lng : DECIMAL(9,6)
  * distance_km : DECIMAL(6,2)
  * fare : DECIMAL(10,2)
  * surge_multiplier : DECIMAL(3,2)
  otp : CHAR(4)
  * status : ENUM('REQUESTED','DRIVER_ASSIGNED','IN_PROGRESS','COMPLETED','CANCELLED')
  * requested_at : TIMESTAMP
  started_at : TIMESTAMP
  completed_at : TIMESTAMP
  ..
  INDEX(rider_id, requested_at)
  INDEX(driver_id, requested_at)
}

entity "ride_rejections" as rejections {
  * ride_id : BIGINT <<PK, FK>>
  * driver_id : BIGINT <<PK, FK>>
  --
  * rejected_at : TIMESTAMP
}

entity "payments" as payments {
  * id : BIGINT <<PK>>
  --
  * ride_id : BIGINT <<FK>>
  * amount : DECIMAL(10,2)
  * method : ENUM('CASH','CARD','UPI','WALLET')
  * status : ENUM('PENDING','SUCCESS','FAILED','REFUNDED')
  transaction_ref : VARCHAR(100)
  * created_at : TIMESTAMP
}

entity "ratings" as ratings {
  * ride_id : BIGINT <<PK, FK>>
  * from_user_id : BIGINT <<PK, FK>>
  --
  * to_user_id : BIGINT <<FK>>
  * stars : TINYINT
  comment : VARCHAR(500)
  ..
  CHECK(stars BETWEEN 1 AND 5)
}

users ||--o| drivers
drivers ||--|| vehicles
users ||--o{ rides : rider
drivers ||--o{ rides : driver
vehicles ||--o{ rides
rides ||--o{ rejections
drivers ||--o{ rejections
rides ||--o{ payments
rides ||--o{ ratings
users ||--o{ ratings

@enduml
